{
  "name": "initiative-app-sdk",
  "version": "1.4.0",
  "description": "Build an app for Initiative: one typed definition of its endpoints, hooks, schedules, widgets and listing, the server Initiative calls, the client it calls Initiative with, the CLI that builds its manifest, and declarative integrations Initiative runs from the manifest alone.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Morelitea/initiative-app-sdk.git"
  },
  "homepage": "https://github.com/Morelitea/initiative-app-sdk#readme",
  "bugs": "https://github.com/Morelitea/initiative-app-sdk/issues",
  "keywords": [
    "initiative",
    "app",
    "sdk",
    "manifest",
    "widget",
    "oauth2",
    "private-key-jwt",
    "jwks",
    "jsonata"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./widget": {
      "types": "./dist/widget.d.ts",
      "default": "./dist/widget.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./schemas/app-manifest.json": "./schemas/app-manifest.json",
    "./manifest.contract.json": "./manifest.contract.json"
  },
  "bin": {
    "initiative-app": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "manifest.contract.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run generate && npm run build",
    "test": "node scripts/run-tests.mjs",
    "test:command": "node --test scripts/check-test-command.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "generate": "node scripts/generate.mjs",
    "check:generated": "node scripts/generate.mjs --check"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "jsonata": "^2.2.2"
  },
  "peerDependencies": {
    "esbuild": ">=0.25.0"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
